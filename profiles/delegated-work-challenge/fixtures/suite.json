      "whyUnsafe": "Advancing both worlds permits work against a superseded objective.",
      "whyNotLive": "Refusing both worlds prevents current authorized work from completing autonomously.",
      "discriminatingFields": ["work.version", "work.status", "work.supersessionRevision"],
      "worlds": {
        "A": {
          "state": {
            "task": {"id": "task-17", "text": "Deploy the approved routing change"},
            "artifact": {"digest": "sha256:1111111111111111111111111111111111111111111111111111111111111111"},
            "tests": {"status": "passing"},
            "run": {"status": "succeeded"},
            "work": {"id": "work-routing", "version": 8, "status": "current", "supersessionRevision": 12}
          }
        },
        "B": {
          "state": {
            "task": {"id": "task-17", "text": "Deploy the approved routing change"},
