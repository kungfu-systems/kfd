{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu-systems.github.io/kfd/schemas/protocol-semantics-design-review-intake-v1.json",
  "title": "KFD Protocol Semantics Design Review Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contract", "engagementId", "subject", "reviewScope", "evidence", "constraints", "claimBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.protocol-semantics-design-review-intake/v1" },
    "engagementId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "version", "sourceCoordinates"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sourceCoordinates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocols", "routes", "questions"],
      "properties": {
        "protocols": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "routes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "questions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "exclusions"],
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["coordinate", "root"],
            "properties": {
              "coordinate": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["networkAccess", "privateAdapterAvailable", "dataMayLeaveOwnerEnvironment"],
      "properties": {
        "networkAccess": { "type": "boolean" },
        "privateAdapterAvailable": { "type": "boolean" },
        "dataMayLeaveOwnerEnvironment": { "type": "boolean" }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificationRequested", "productionEnforcementObserved", "commercialAgreementIncluded"],
      "properties": {
        "certificationRequested": { "const": false },
        "productionEnforcementObserved": { "const": false },
        "commercialAgreementIncluded": { "const": false }
      }
    }
  }
}
