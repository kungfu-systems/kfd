  "vectors": [
    {
      "id": "scp-v001",
      "invariant": "The fixed candidate-genesis example closes from the reviewed bootstrap without claiming authority.",
      "polarity": "positive",
      "operations": [],
      "expected": {
        "valid": true,
        "code": null
      }
    },
    {
      "id": "scp-v002",
      "invariant": "Unknown profile versions fail closed.",
      "polarity": "negative",
      "operations": [
        {
          "op": "replace",
          "path": "/profile",
          "value": "kfd-self-conformance@2"
        }
      ],
      "expected": {
        "valid": false,
        "code": "scp-profile-version-unsupported"
      }
    },
    {
