{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-1/contract-world.schema.json",
  "title": "KFD-1 contract world",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "factSource",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-1-contract-world"
    },
    "standard": {
      "const": "kfd-1"
    },
    "factSource": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityImpactClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibilityImpact"
      },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "class": {
            "$ref": "#/$defs/surfaceClass"
          },
          "classes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/surfaceClass"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weldRationale": {
            "type": "string",
            "minLength": 1
          },
          "impactProjection": {
            "$ref": "#/$defs/impactProjection"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "surfaceClass": {
      "enum": [
        "integration-time",
        "cross-time"
      ]
    },
    "compatibilityImpact": {
      "enum": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ]
    },
    "impactProjection": {
      "type": "object",
      "required": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ],
      "properties": {
        "breaking": {
          "type": "string",
          "minLength": 1
        },
        "additive": {
          "type": "string",
          "minLength": 1
        },
        "none": {
          "type": "string",
          "minLength": 1
        },
        "unclassifiable": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
