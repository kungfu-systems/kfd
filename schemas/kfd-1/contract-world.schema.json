{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-1/contract-world.schema.json",
  "title": "KFD-1 contract world",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "factSource",
    "surfaces"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-1-contract-world"
    },
    "standard": {
      "const": "kfd-1"
    },
    "factSource": {
      "type": "string",
      "minLength": 1
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "class": {
            "enum": [
              "integration-time",
              "cross-time"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
