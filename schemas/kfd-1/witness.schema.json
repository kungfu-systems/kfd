{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-1/witness.schema.json",
  "title": "KFD-1 witness",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "contractWorld",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-1-witness"
    },
    "standard": {
      "const": "kfd-1"
    },
    "contractWorld": {
      "type": "object",
      "required": [
        "schemaId",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://kfd.libkungfu.dev/schemas/kfd-1/contract-world.schema.json"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "compatibilityImpactClasses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compatibilityImpact"
      },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "class",
          "description",
          "sourcePath",
          "artifactPath",
          "impactProjection"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "$ref": "#/$defs/surfaceClass"
          },
          "classes": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/surfaceClass"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "weldRationale": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "artifactPath": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expectedSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byteForByte": {
            "type": "boolean"
          },
          "impactProjection": {
            "$ref": "#/$defs/impactProjection"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "surfaceClass": {
      "enum": [
        "integration-time",
        "cross-time"
      ]
    },
    "compatibilityImpact": {
      "enum": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ]
    },
    "impactProjection": {
      "type": "object",
      "required": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ],
      "properties": {
        "breaking": {
          "type": "string",
          "minLength": 1
        },
        "additive": {
          "type": "string",
          "minLength": 1
        },
        "none": {
          "type": "string",
          "minLength": 1
        },
        "unclassifiable": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
