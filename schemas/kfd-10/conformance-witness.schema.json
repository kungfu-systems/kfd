{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-10/conformance-witness.schema.json",
  "title": "KFD-10 experimental Warrant lifecycle conformance witness",
  "type": "object",
  "required": ["$schema", "schemaVersion", "contract", "profile", "warrant", "observation", "qualifying", "selfCertified"],
  "properties": {
    "$schema": {"const": "https://kfd.libkungfu.dev/schemas/kfd-10/conformance-witness.schema.json"},
    "schemaVersion": {"const": 2},
    "contract": {"const": "kfd.warrant-conformance-witness/v2"},
    "profile": {"const": "kfd-10-warrant@0.2.0-alpha.1"},
    "warrant": {
      "type": "object",
      "required": ["id", "root", "purpose", "authority", "lease", "continuation", "recovery", "revocation", "settlement", "authorization", "history"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/root"},
        "purpose": {
          "type": "object",
          "required": ["statement", "action", "subject", "resource", "targetState", "nonClaims"],
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "action": {"type": "string", "minLength": 1},
            "subject": {"type": "string", "minLength": 1},
            "resource": {"type": "string", "minLength": 1},
            "targetState": {"type": "string", "minLength": 1},
            "nonClaims": {"$ref": "#/$defs/nonEmptyStrings"}
          },
          "additionalProperties": false
        },
        "authority": {
          "type": "object",
          "required": ["issuer", "holder", "scope", "targetRoots", "derivation", "delegation", "residualResponsibility"],
          "properties": {
            "issuer": {"type": "string", "minLength": 1},
            "holder": {"type": "string", "minLength": 1},
            "scope": {
              "type": "object",
              "required": ["actions", "subjects", "resources", "consequenceCeiling"],
              "properties": {
                "actions": {"$ref": "#/$defs/nonEmptyStrings"},
                "subjects": {"$ref": "#/$defs/nonEmptyStrings"},
                "resources": {"$ref": "#/$defs/nonEmptyStrings"},
                "consequenceCeiling": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "targetRoots": {"$ref": "#/$defs/nonEmptyRoots"},
            "derivation": {
              "type": "object",
              "required": ["parentRoot", "parentConsequenceCeiling", "attenuated", "independentAuthorityRoot"],
              "properties": {
                "parentRoot": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]},
                "parentConsequenceCeiling": {"type": ["integer", "null"], "minimum": 0},
                "attenuated": {"type": "boolean"},
                "independentAuthorityRoot": {"anyOf": [{"$ref": "#/$defs/root"}, {"type": "null"}]}
              },
              "additionalProperties": false
            },
            "delegation": {
              "type": "object",
              "required": ["delegated", "from", "chainRoots"],
              "properties": {
                "delegated": {"type": "boolean"},
                "from": {"type": ["string", "null"]},
                "chainRoots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/root"}}
              },
              "additionalProperties": false
            },
            "residualResponsibility": {"$ref": "#/$defs/nonEmptyStrings"}
          },
          "additionalProperties": false
        },
        "lease": {
          "type": "object",
          "required": ["id", "generation", "fencingToken", "notBefore", "expiresAt", "renewable", "nonPreemptive"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "generation": {"type": "integer", "minimum": 1},
            "fencingToken": {"$ref": "#/$defs/root"},
            "notBefore": {"type": "string", "format": "date-time"},
            "expiresAt": {"type": "string", "format": "date-time"},
            "renewable": {"type": "boolean"},
            "nonPreemptive": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "continuation": {
          "type": "object",
          "required": ["state", "heartbeatAt", "expectedGeneration", "expectedFencingToken", "receiptRoot"],
          "properties": {
            "state": {"const": "continued"},
            "heartbeatAt": {"type": "string", "format": "date-time"},
            "expectedGeneration": {"type": "integer", "minimum": 1},
            "expectedFencingToken": {"$ref": "#/$defs/root"},
            "receiptRoot": {"$ref": "#/$defs/root"}
          },
          "additionalProperties": false
        },
        "recovery": {
          "type": "object",
          "required": ["performed", "expiredGeneration", "rejectedFencingToken", "expectedOldRoot", "successorGeneration", "successorFencingToken", "receiptRoot"],
          "properties": {
            "performed": {"const": true},
            "expiredGeneration": {"type": "integer", "minimum": 1},
            "rejectedFencingToken": {"$ref": "#/$defs/root"},
            "expectedOldRoot": {"$ref": "#/$defs/root"},
            "successorGeneration": {"type": "integer", "minimum": 1},
            "successorFencingToken": {"$ref": "#/$defs/root"},
            "receiptRoot": {"$ref": "#/$defs/root"}
          },
          "additionalProperties": false
        },
        "revocation": {
          "type": "object",
          "required": ["state", "revokedAt", "authorityRoot"],
          "properties": {
            "state": {"enum": ["not-revoked", "revoked"]},
            "revokedAt": {"type": ["string", "null"]},
            "authorityRoot": {"$ref": "#/$defs/root"}
          },
          "additionalProperties": false
        },
        "settlement": {
          "type": "object",
          "required": ["state", "at", "outcome", "evidenceRoot", "expectedOldRoot", "nextStateRoot", "duplicate", "receiptRoot"],
          "properties": {
            "state": {"const": "applied"},
            "at": {"type": "string", "format": "date-time"},
            "outcome": {"type": "string", "minLength": 1},
            "evidenceRoot": {"$ref": "#/$defs/root"},
            "expectedOldRoot": {"$ref": "#/$defs/root"},
            "nextStateRoot": {"$ref": "#/$defs/root"},
            "duplicate": {"type": "boolean"},
            "receiptRoot": {"$ref": "#/$defs/root"}
          },
          "additionalProperties": false
        },
        "authorization": {
          "type": "object",
          "required": ["authorized", "occurred", "occurrenceUsedAsAuthority", "reuseAttempted"],
          "properties": {
            "authorized": {"type": "boolean"},
            "occurred": {"type": "boolean"},
            "occurrenceUsedAsAuthority": {"const": false},
            "reuseAttempted": {"type": "boolean"}
          },
          "additionalProperties": false
        },
        "history": {
          "type": "object",
          "required": ["priorRoot", "currentRoot", "rewritten", "events"],
          "properties": {
            "priorRoot": {"$ref": "#/$defs/root"},
            "currentRoot": {"$ref": "#/$defs/root"},
            "rewritten": {"const": false},
            "events": {
              "type": "array",
              "minItems": 6,
              "items": {
                "type": "object",
                "required": ["event", "at", "root", "generation"],
                "properties": {
                  "event": {"enum": ["issued", "expired", "recovered", "continued", "occurred", "settled", "attenuated", "delegated", "renewed", "revoked", "refused"]},
                  "at": {"type": "string", "format": "date-time"},
                  "root": {"$ref": "#/$defs/root"},
                  "generation": {"type": "integer", "minimum": 1}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["at", "holder", "action", "subject", "resource", "targetRoots", "generation", "fencingToken"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "holder": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "targetRoots": {"$ref": "#/$defs/nonEmptyRoots"},
        "generation": {"type": "integer", "minimum": 1},
        "fencingToken": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "qualifying": {"const": false},
    "selfCertified": {"const": false}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyRoots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/root"}}
  },
  "additionalProperties": false
}
