{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-11/decision-admission.schema.json",
  "title": "KFD-11 Decision Admission Record",
  "description": "Binds one exact Claim through purpose-bound Assessment and Warrant-bound Decision to an independently reported Admission result. Structural validity is not semantic qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "claim",
    "assessments",
    "decision",
    "admission",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd-11-decision-admission" },
    "standard": { "const": "kfd-11" },
    "claim": { "$ref": "#/$defs/artifactBinding" },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactBinding" }
    },
    "decision": { "$ref": "#/$defs/decision" },
    "admission": { "$ref": "#/$defs/admission" },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "admission": {
            "properties": { "outcome": { "const": "admitted" } },
            "required": ["outcome"]
          }
        }
      },
      "then": {
        "properties": {
          "admission": {
            "required": ["successorFactCut", "receipt"]
          }
        }
      },
      "else": {
        "properties": {
          "admission": {
            "properties": {
              "successorFactCut": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*:[A-Za-z0-9._~+/=-]+$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaId", "root"],
      "properties": {
        "schemaId": { "type": "string", "format": "uri-reference", "minLength": 1 },
        "root": { "$ref": "#/$defs/root" },
        "coordinate": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decisionMakerRef",
        "assessmentRoots",
        "warrant",
        "purposeRoot",
        "dispositionClass",
        "disposition",
        "acceptedScopeRoot",
        "conditionRoots",
        "requestedEffectRoots",
        "reasonRoot",
        "residualRiskRoots"
      ],
      "properties": {
        "decisionId": { "$ref": "#/$defs/id" },
        "decisionMakerRef": { "$ref": "#/$defs/id" },
        "assessmentRoots": { "$ref": "#/$defs/nonEmptyRootSet" },
        "warrant": { "$ref": "#/$defs/artifactBinding" },
        "purposeRoot": { "$ref": "#/$defs/root" },
        "dispositionClass": {
          "enum": ["accept", "accept-conditionally", "accept-partially", "reject", "defer", "request-evidence"]
        },
        "disposition": { "type": "string", "minLength": 1 },
        "acceptedScopeRoot": { "$ref": "#/$defs/nullableRoot" },
        "conditionRoots": { "$ref": "#/$defs/rootSet" },
        "requestedEffectRoots": { "$ref": "#/$defs/nonEmptyRootSet" },
        "reasonRoot": { "$ref": "#/$defs/root" },
        "residualRiskRoots": { "$ref": "#/$defs/rootSet" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admissionId",
        "authorityRef",
        "basisFactCut",
        "requestedTransition",
        "outcome"
      ],
      "properties": {
        "admissionId": { "$ref": "#/$defs/id" },
        "authorityRef": { "$ref": "#/$defs/id" },
        "basisFactCut": { "$ref": "#/$defs/artifactBinding" },
        "requestedTransition": { "$ref": "#/$defs/artifactBinding" },
        "outcome": {
          "enum": ["not-attempted", "admitted", "rejected", "stale", "conflicted", "failed"]
        },
        "successorFactCut": { "$ref": "#/$defs/artifactBinding" },
        "receipt": { "$ref": "#/$defs/artifactBinding" },
        "failure": { "$ref": "#/$defs/artifactBinding" }
      }
    },
    "nullableRoot": {
      "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }]
    },
    "rootSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/root" }
    },
    "nonEmptyRootSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/root" }
    }
  }
}
