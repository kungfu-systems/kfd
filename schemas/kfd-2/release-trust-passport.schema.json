{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-2/release-trust-passport.schema.json",
  "title": "KFD-2 release trust passport",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "product",
    "release",
    "releaseClaims",
    "result",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-2-release-trust-passport"
    },
    "standard": {
      "const": "kfd-2"
    },
    "product": {
      "$ref": "#/$defs/product"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "releaseClaims": {
      "type": "object",
      "required": [
        "schemaId",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://kfd.libkungfu.dev/schemas/kfd-2/release-claims.schema.json"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "unverifiable"
      ]
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claimResult"
      }
    },
    "unboundClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downgradeReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "responsibility": {
      "$ref": "#/$defs/responsibilityState"
    },
    "schemaEvolution": {
      "$ref": "#/$defs/schemaEvolution"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "product": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": [
        "version",
        "channel"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "claimResult": {
      "type": "object",
      "required": [
        "id",
        "result",
        "evidence",
        "auditBoundary",
        "responsibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "unverifiable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceResult"
          }
        },
        "auditBoundary": {
          "$ref": "#/$defs/auditBoundary"
        },
        "responsibility": {
          "$ref": "#/$defs/responsibilityState"
        },
        "residualRisk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "evidenceResult": {
      "type": "object",
      "required": [
        "type",
        "result"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "unverifiable"
          ]
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "auditBoundary": {
      "type": "object",
      "required": [
        "scope",
        "enumerability"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "enumerability": {
          "enum": [
            "closed-world",
            "declared-open",
            "sampled",
            "manual"
          ]
        }
      },
      "additionalProperties": true
    },
    "responsibilityState": {
      "type": "object",
      "required": [
        "sourceOwner",
        "verificationOwner",
        "releaseDecisionOwner"
      ],
      "properties": {
        "sourceOwner": {
          "type": "string",
          "minLength": 1
        },
        "verificationOwner": {
          "type": "string",
          "minLength": 1
        },
        "releaseDecisionOwner": {
          "type": "string",
          "minLength": 1
        },
        "escalation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "schemaEvolution": {
      "type": "object",
      "required": [
        "interfaceVersion",
        "compatibilityRule"
      ],
      "properties": {
        "interfaceVersion": {
          "const": 1
        },
        "compatibilityRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
