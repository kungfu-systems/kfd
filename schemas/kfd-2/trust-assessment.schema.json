{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-assessment.schema.json",
  "title": "KFD-2 trust assessment",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "assessedClaims",
    "result",
    "assessments",
    "responsibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-2-trust-assessment"
    },
    "standard": {
      "const": "kfd-2"
    },
    "assessedClaims": {
      "type": "object",
      "required": [
        "schemaId",
        "digest"
      ],
      "properties": {
        "schemaId": {
          "const": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-claims.schema.json"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "warning",
        "unverifiable"
      ]
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimAssessment"
      }
    },
    "unboundClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "downgradeReasons": {
      "type": "array",
      "items": {
        "$ref": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-taxonomy.schema.json#/$defs/downgradeReason"
      }
    },
    "responsibility": {
      "$ref": "#/$defs/responsibilityState"
    },
    "projection": {
      "$ref": "#/$defs/projection"
    },
    "schemaEvolution": {
      "$ref": "#/$defs/schemaEvolution"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "claimAssessment": {
      "type": "object",
      "required": [
        "id",
        "claimId",
        "subject",
        "result",
        "facts",
        "evidence",
        "auditBoundary",
        "responsibility"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "claimId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "subject": {
          "$ref": "#/$defs/claimSubject"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "unverifiable"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceResult"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceResult"
          }
        },
        "auditBoundary": {
          "$ref": "#/$defs/auditBoundary"
        },
        "responsibility": {
          "$ref": "#/$defs/responsibilityState"
        },
        "residualRisk": {
          "type": "array",
          "items": {
            "$ref": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-taxonomy.schema.json#/$defs/residualRisk"
          }
        }
      },
      "additionalProperties": true
    },
    "claimSubject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "kfd-standard",
            "contract-world",
            "collaboration-interface",
            "observer-perspective",
            "release",
            "artifact",
            "config",
            "api",
            "abi",
            "gui-surface",
            "runtime-fact",
            "documentation",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "standard": {
          "type": "string",
          "pattern": "^kfd-[1-9][0-9]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "evidenceResult": {
      "type": "object",
      "required": [
        "type",
        "result",
        "machineProvability"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "warning",
            "unverifiable"
          ]
        },
        "machineProvability": {
          "$ref": "https://kfd.libkungfu.dev/schemas/kfd-2/trust-taxonomy.schema.json#/$defs/machineProvability"
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "auditBoundary": {
      "type": "object",
      "required": [
        "scope",
        "enumerability"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "enumerability": {
          "enum": [
            "closed-world",
            "declared-open",
            "sampled",
            "manual"
          ]
        }
      },
      "additionalProperties": true
    },
    "responsibilityState": {
      "type": "object",
      "required": [
        "owner",
        "sourceOwner",
        "verificationOwner",
        "decisionOwner"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "sourceOwner": {
          "type": "string",
          "minLength": 1
        },
        "verificationOwner": {
          "type": "string",
          "minLength": 1
        },
        "decisionOwner": {
          "type": "string",
          "minLength": 1
        },
        "escalation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "projection": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "generic",
            "release",
            "package",
            "site",
            "runtime",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "schemaEvolution": {
      "type": "object",
      "required": [
        "compatibilityRule"
      ],
      "properties": {
        "compatibilityRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
