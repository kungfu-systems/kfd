{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-4/perspective-replay.schema.json",
  "title": "KFD-4 perspective-preserving replay",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "replayId",
    "mode",
    "sourceViews",
    "replayObserver",
    "reconstruction",
    "verification"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd-4-perspective-replay" },
    "standard": { "const": "kfd-4" },
    "replayId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["perspective-preserving", "contrastive"] },
    "sourceViews": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceView" }
    },
    "replayObserver": { "$ref": "#/$defs/replayObserver" },
    "reconstruction": { "$ref": "#/$defs/reconstruction" },
    "contrast": { "$ref": "#/$defs/contrast" },
    "verification": { "$ref": "#/$defs/verification" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "contrastive" } },
        "required": ["mode"]
      },
      "then": {
        "required": ["contrast"],
        "properties": {
          "sourceViews": { "minItems": 2 }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sourceView": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "coordinate",
        "observer",
        "perspective",
        "acceptedFactCut",
        "naturalObjects",
        "consequences",
        "knownGaps"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["episode-timeline", "observer-view", "other"] },
        "coordinate": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observer": { "type": "string", "minLength": 1 },
        "perspective": { "type": "string", "minLength": 1 },
        "acceptedFactCut": { "type": "string", "minLength": 1 },
        "naturalObjects": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "knownGaps": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "replayObserver": {
      "type": "object",
      "required": ["id", "kind", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["human", "agent", "collective", "service", "other"] },
        "purpose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reconstruction": {
      "type": "object",
      "required": [
        "policyVersion",
        "sharedContext",
        "preservedElements",
        "declaredLoss",
        "degradedState"
      ],
      "properties": {
        "policyVersion": { "type": "string", "minLength": 1 },
        "sharedContext": { "type": "string", "minLength": 1 },
        "preservedElements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "observer",
              "accepted-fact-cut",
              "causal-order",
              "natural-objects",
              "consequences",
              "evidence-boundary",
              "known-gaps"
            ]
          }
        },
        "declaredLoss": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "degradedState": {
          "enum": ["none", "partial-context", "missing-evidence", "stale-source", "unverified-source", "other"]
        }
      },
      "additionalProperties": false
    },
    "contrast": {
      "type": "object",
      "required": ["dimensions", "mismatches"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["natural-object", "friction", "consequence", "action-cost", "authority", "evidence-boundary", "other"]
          }
        },
        "mismatches": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mismatch" }
        }
      },
      "additionalProperties": false
    },
    "mismatch": {
      "type": "object",
      "required": ["sourceViewIds", "observation", "primitiveSignal"],
      "properties": {
        "sourceViewIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "observation": { "type": "string", "minLength": 1 },
        "primitiveSignal": { "enum": ["absent", "candidate", "inconclusive", "rejected"] }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["result", "evidence"],
      "properties": {
        "result": { "enum": ["pass", "degraded", "fail", "not-checked"] },
        "evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
