{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-5/primitive-discovery.schema.json",
  "title": "KFD-5 primitive discovery record",
  "type": "object",
  "required": ["schemaVersion", "contract", "standard", "candidate", "perspectiveGenesis", "grounding", "participants", "alternatives", "contractModel", "tests", "decision"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contract": { "const": "kfd-5-primitive-discovery" },
    "standard": { "const": "kfd-5" },
    "candidate": {
      "type": "object",
      "required": ["id", "title", "problemStatement", "scope"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "problemStatement": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "perspectiveGenesis": {
      "type": "object",
      "required": ["genesisMethod", "originPerspective", "transformedPerspective", "transformation", "situatedObservation", "newlyVisibleNeed", "candidateObject", "claimBoundary"],
      "properties": {
        "genesisMethod": {
          "enum": ["direct-situated-experience", "perspective-replay", "contrastive-replay", "other"]
        },
        "originPerspective": { "$ref": "#/$defs/perspective" },
        "transformedPerspective": { "$ref": "#/$defs/perspective" },
        "transformation": { "type": "string", "minLength": 1 },
        "situatedObservation": { "type": "string", "minLength": 1 },
        "newlyVisibleNeed": { "type": "string", "minLength": 1 },
        "candidateObject": { "type": "string", "minLength": 1 },
        "claimBoundary": { "type": "string", "minLength": 1 },
        "replayBasis": { "$ref": "#/$defs/replayBasis" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "genesisMethod": { "enum": ["perspective-replay", "contrastive-replay"] }
            },
            "required": ["genesisMethod"]
          },
          "then": { "required": ["replayBasis"] }
        },
        {
          "if": {
            "properties": { "genesisMethod": { "const": "contrastive-replay" } },
            "required": ["genesisMethod"]
          },
          "then": {
            "properties": {
              "replayBasis": {
                "properties": { "sourceViewIds": { "minItems": 2 } }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "boundaryPressure": { "$ref": "#/$defs/boundaryPressure" },
    "grounding": {
      "type": "object",
      "required": ["pressure", "factSources", "evidenceBoundary", "knownGaps"],
      "properties": {
        "pressure": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "factSources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencePointer" } },
        "evidenceBoundary": { "type": "string", "minLength": 1 },
        "knownGaps": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "functions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["human", "agent", "collective", "other"] },
          "functions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["perspective-grounded-judgment", "scalable-reasoning", "evidence-custody", "verification", "decision"] }
          }
        },
        "additionalProperties": false
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "disposition", "reason"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["retained", "rejected", "subsumed", "unresolved"] },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "contractModel": {
      "type": "object",
      "required": ["identity", "boundary", "authority", "lifecycle", "operations"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "boundary": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "lifecycle": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": ["minimumClosure", "deletion", "fuse", "falsifiers", "dogfood"],
      "properties": {
        "minimumClosure": { "$ref": "#/$defs/testResult" },
        "deletion": { "$ref": "#/$defs/testResult" },
        "fuse": { "$ref": "#/$defs/testResult" },
        "falsifiers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "dogfood": { "$ref": "#/$defs/testResult" }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["outcome", "owner", "reason", "residualRisks"],
      "properties": {
        "outcome": { "enum": ["accepted", "provisional", "rejected", "subsumed", "no-new-primitive"] },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "residualRisks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "perspective": {
      "type": "object",
      "required": ["id", "bearer", "role", "proximity", "consequences"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "bearer": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "proximity": { "type": "string", "minLength": 1 },
        "consequences": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "naturalObjects": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "replayBasis": {
      "type": "object",
      "required": ["replayRecord", "sourceViewIds", "sharedContext", "preservationClaim", "degradedState"],
      "properties": {
        "replayRecord": { "$ref": "#/$defs/evidencePointer" },
        "sourceViewIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sharedContext": { "type": "string", "minLength": 1 },
        "preservationClaim": { "type": "string", "minLength": 1 },
        "degradedState": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "boundaryPressure": {
      "type": "object",
      "required": ["contactSides", "implicitHandling", "pressureChanges", "observedFailures", "mediationClaim", "internalObjectAlternative"],
      "properties": {
        "contactSides": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "implicitHandling": { "type": "string", "minLength": 1 },
        "pressureChanges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "description"],
            "properties": {
              "kind": { "enum": ["new-participant", "scale", "frequency", "authority", "heterogeneity", "latency", "consequence", "other"] },
              "description": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "observedFailures": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "mediationClaim": { "type": "string", "minLength": 1 },
        "internalObjectAlternative": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "evidencePointer": {
      "type": "object",
      "required": ["kind", "coordinate"],
      "properties": {
        "kind": { "enum": ["file", "git", "episode", "trace", "receipt", "dataset", "other"] },
        "coordinate": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "testResult": {
      "type": "object",
      "required": ["result", "evidence"],
      "properties": {
        "result": { "enum": ["pass", "fail", "inconclusive", "not-run"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidencePointer" } },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
