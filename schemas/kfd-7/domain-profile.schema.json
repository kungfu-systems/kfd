{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-7/domain-profile.schema.json",
  "title": "KFD-7 Domain Profile Declaration",
  "description": "Declares how one adopting domain binds representations to the KFD-7 Fact-Episode Ontology and maps direction, perspective, and authority into the Action Responsibility Geometry. Structural validity does not qualify or activate a Domain Profile.",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "standard",
    "domainProfile",
    "ontologyBindings",
    "actionCoordinates",
    "transitions",
    "prohibitedInferences",
    "qualificationBasis",
    "evidenceObligations",
    "nonClaims",
    "extensions",
    "activation"
  ],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-7/domain-profile.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-7-domain-profile"
    },
    "standard": {
      "const": "kfd-7"
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "prohibitedInferences": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "authority-from-pursuit",
          "complete-reality-from-atlas",
          "occurrence-from-warrant",
          "authorization-from-episode",
          "completion-from-episode",
          "occurrence-from-fact",
          "child-authority-from-parent",
          "causal-equivalence-from-equal-endpoints"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "authority-from-pursuit"
          }
        },
        {
          "contains": {
            "const": "complete-reality-from-atlas"
          }
        },
        {
          "contains": {
            "const": "occurrence-from-warrant"
          }
        },
        {
          "contains": {
            "const": "authorization-from-episode"
          }
        },
        {
          "contains": {
            "const": "completion-from-episode"
          }
        },
        {
          "contains": {
            "const": "occurrence-from-fact"
          }
        },
        {
          "contains": {
            "const": "child-authority-from-parent"
          }
        },
        {
          "contains": {
            "const": "causal-equivalence-from-equal-endpoints"
          }
        }
      ]
    },
    "qualificationBasis": {
      "$ref": "#/$defs/qualificationBasis"
    },
    "evidenceObligations": {
      "description": "Evidence obligations concern semantic distinguishability, traceability, runtime behavior, and qualification; physical component count is not evidence.",
      "type": "array",
      "minItems": 13,
      "items": {
        "$ref": "#/$defs/evidenceObligation"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "semantic-component-deletion-or-fusion"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "invalid-transition"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "export-import-rebuild"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "backend-migration"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "concurrency-retry-compensation"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "warrant-decay-revocation"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "atlas-staleness-loss"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "pursuit-continuity-settlement"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "episode-replay-contraction"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "cold-start-continuation"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "session-round-trip-refinement"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "session-complexity-breakpoint"
              }
            },
            "required": [
              "category"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "category": {
                "const": "context-insufficiency-counterexample"
              }
            },
            "required": [
              "category"
            ]
          }
        }
      ]
    },
    "nonClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "activation": {
      "$ref": "#/$defs/activation"
    },
    "domainProfile": {
      "description": "Identity, implementation coordinate, and qualification state of the adopting Domain Profile.",
      "$ref": "#/$defs/domainProfile"
    },
    "ontologyBindings": {
      "description": "Exactly two semantic bindings: admitted Fact state and replayable Episode occurrence. Physical storage may be shared, but the bindings remain independently traceable.",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/ontologyBinding"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "binding": {
                "const": "fact"
              }
            },
            "required": [
              "binding"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "binding": {
                "const": "episode"
              }
            },
            "required": [
              "binding"
            ]
          }
        }
      ]
    },
    "actionCoordinates": {
      "description": "Exactly three independently addressable action coordinates: direction (Pursuit), perspective (Atlas), and bounded authority (Warrant).",
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/actionCoordinate"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "coordinate": {
                "const": "pursuit"
              }
            },
            "required": [
              "coordinate"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "coordinate": {
                "const": "atlas"
              }
            },
            "required": [
              "coordinate"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "coordinate": {
                "const": "warrant"
              }
            },
            "required": [
              "coordinate"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "activation": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "activate"
              }
            },
            "required": [
              "decision"
            ]
          }
        },
        "required": [
          "activation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "activation": {
            "type": "object",
            "required": [
              "evidenceCut",
              "independentReview",
              "productWitnesses"
            ],
            "properties": {
              "productWitnesses": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "evidenceObligations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "passed",
                    "not-applicable"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "const": "session-round-trip-refinement"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "category",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "const": "session-complexity-breakpoint"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "category",
                    "status"
                  ]
                }
              },
              {
                "contains": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "const": "context-insufficiency-counterexample"
                    },
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "category",
                    "status"
                  ]
                }
              }
            ]
          },
          "domainProfile": {
            "type": "object",
            "properties": {
              "qualificationStatus": {
                "const": "qualified"
              }
            },
            "required": [
              "qualificationStatus"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "transition": {
      "type": "object",
      "required": [
        "id",
        "subject",
        "operation",
        "from",
        "to",
        "preconditions",
        "effect",
        "receipt",
        "evidence",
        "denialReasons",
        "residualRisks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "operation": {
          "enum": [
            "create",
            "advance",
            "revise",
            "supersede",
            "seal",
            "settle",
            "complete",
            "abandon",
            "terminate",
            "derive",
            "attenuate",
            "expire",
            "revoke",
            "refuse",
            "reconcile",
            "reject",
            "profile-extension"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denialReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "residualRisks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "subject": {
          "enum": [
            "fact",
            "episode",
            "pursuit",
            "atlas",
            "warrant"
          ]
        }
      },
      "additionalProperties": false
    },
    "qualificationBasis": {
      "type": "object",
      "required": [
        "sessionRoundTrip",
        "contextInsufficiency",
        "evidenceCategories"
      ],
      "properties": {
        "sessionRoundTrip": {
          "type": "object",
          "required": [
            "theoremId",
            "theoremVersion",
            "source",
            "applicability",
            "semanticDimensions",
            "implementationRefs"
          ],
          "properties": {
            "theoremId": {
              "const": "kfd-7-session-round-trip-preservation"
            },
            "theoremVersion": {
              "const": 1
            },
            "source": {
              "const": "docs/KFD-7-formal.md#session-round-trip-preservation-theorem"
            },
            "applicability": {
              "const": "session-compressible-only"
            },
            "semanticDimensions": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "direction",
                  "perspective-boundary",
                  "effective-authority",
                  "causal-process",
                  "admitted-result"
                ]
              },
              "allOf": [
                {
                  "contains": {
                    "const": "direction"
                  }
                },
                {
                  "contains": {
                    "const": "perspective-boundary"
                  }
                },
                {
                  "contains": {
                    "const": "effective-authority"
                  }
                },
                {
                  "contains": {
                    "const": "causal-process"
                  }
                },
                {
                  "contains": {
                    "const": "admitted-result"
                  }
                }
              ]
            },
            "implementationRefs": {
              "type": "object",
              "required": [
                "expand",
                "project",
                "compressibilityPredicate"
              ],
              "properties": {
                "expand": {
                  "type": "string",
                  "minLength": 1
                },
                "project": {
                  "type": "string",
                  "minLength": 1
                },
                "compressibilityPredicate": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "contextInsufficiency": {
          "type": "object",
          "required": [
            "corollaryId",
            "corollaryVersion",
            "source",
            "conclusion"
          ],
          "properties": {
            "corollaryId": {
              "const": "kfd-7-context-insufficiency"
            },
            "corollaryVersion": {
              "const": 1
            },
            "source": {
              "const": "docs/KFD-7-formal.md#context-insufficiency-corollary"
            },
            "conclusion": {
              "const": "context-alone-is-not-sufficient"
            }
          },
          "additionalProperties": false
        },
        "evidenceCategories": {
          "type": "object",
          "required": [
            "roundTripRefinement",
            "complexityBreakpoint",
            "contextCounterexample"
          ],
          "properties": {
            "roundTripRefinement": {
              "const": "session-round-trip-refinement"
            },
            "complexityBreakpoint": {
              "const": "session-complexity-breakpoint"
            },
            "contextCounterexample": {
              "const": "context-insufficiency-counterexample"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "evidenceObligation": {
      "type": "object",
      "required": [
        "category",
        "status",
        "artifactRefs",
        "residualRisk"
      ],
      "properties": {
        "category": {
          "enum": [
            "semantic-component-deletion-or-fusion",
            "invalid-transition",
            "export-import-rebuild",
            "backend-migration",
            "concurrency-retry-compensation",
            "warrant-decay-revocation",
            "atlas-staleness-loss",
            "pursuit-continuity-settlement",
            "episode-replay-contraction",
            "cold-start-continuation",
            "session-round-trip-refinement",
            "session-complexity-breakpoint",
            "context-insufficiency-counterexample",
            "profile-extension"
          ]
        },
        "status": {
          "enum": [
            "planned",
            "passed",
            "failed",
            "not-applicable"
          ]
        },
        "artifactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "residualRisk": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "artifactRefs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "required": [
        "id",
        "owner",
        "version",
        "mapping",
        "compatibilityRule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "mapping": {
          "type": "string",
          "minLength": 1
        },
        "compatibilityRule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": [
        "decision",
        "evidenceCut",
        "independentReview",
        "productWitnesses",
        "residualRisk"
      ],
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "activate",
            "revise",
            "reject"
          ]
        },
        "evidenceCut": {
          "type": "string",
          "minLength": 1
        },
        "independentReview": {
          "type": "string",
          "minLength": 1
        },
        "productWitnesses": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "residualRisk": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "domainProfile": {
      "type": "object",
      "required": [
        "id",
        "version",
        "product",
        "implementation",
        "qualificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "qualificationStatus": {
          "enum": [
            "provisional",
            "qualifying",
            "qualified",
            "rejected"
          ]
        }
      },
      "additionalProperties": false
    },
    "ontologyBinding": {
      "description": "Maps one domain representation to admitted Fact state or replayable Episode occurrence.",
      "type": "object",
      "required": [
        "binding",
        "identity",
        "sourceAuthority",
        "semantics",
        "lifecycleVocabulary",
        "requiredEvidence",
        "nonClaims"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sourceAuthority": {
          "type": "string",
          "minLength": 1
        },
        "lifecycleVocabulary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domainTerm": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "enum": [
            "fact",
            "episode"
          ]
        }
      },
      "additionalProperties": false
    },
    "actionCoordinate": {
      "description": "Maps one domain representation to a direction, perspective, or bounded-authority coordinate.",
      "type": "object",
      "required": [
        "coordinate",
        "identity",
        "sourceAuthority",
        "semantics",
        "lifecycleVocabulary",
        "requiredEvidence",
        "nonClaims"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "sourceAuthority": {
          "type": "string",
          "minLength": 1
        },
        "lifecycleVocabulary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredEvidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nonClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "domainTerm": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string",
          "minLength": 1
        },
        "coordinate": {
          "enum": [
            "pursuit",
            "atlas",
            "warrant"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
