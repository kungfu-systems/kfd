{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-8/atlas-coordinate.schema.json",
  "title": "KFD-8 Atlas coordinate witness",
  "type": "object",
  "required": ["schemaVersion", "contract", "standard", "profileVersion", "identity", "holder", "sources", "factCut", "scope", "freshness", "loss", "state", "lineage", "currentReference", "semanticInferences", "verification"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd-8-atlas-coordinate" },
    "standard": { "const": "kfd-8" },
    "profileVersion": { "const": "0.1.0-alpha.1" },
    "identity": {
      "type": "object",
      "required": ["atlasId", "version", "root"],
      "properties": {
        "atlasId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "holder": {
      "type": "object",
      "required": ["id", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "authority", "factCutRoot"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "relevance": { "type": "string" },
          "factCutRoot": { "$ref": "#/$defs/root" }
        },
        "additionalProperties": false
      }
    },
    "factCut": {
      "type": "object",
      "required": ["id", "root"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["included", "omitted", "unknowns"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "omitted": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "unknowns": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["state", "observedAt", "condition"],
      "properties": {
        "state": { "enum": ["current", "stale", "unknown"] },
        "observedAt": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "loss": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "state": {
      "type": "object",
      "required": ["stale", "degraded", "conflicted"],
      "properties": {
        "stale": { "type": "boolean" },
        "degraded": { "type": "boolean" },
        "conflicted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["predecessorRoots", "transformation", "preservedRoots"],
      "properties": {
        "predecessorRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
        "transformation": { "type": "string", "minLength": 1 },
        "preservedRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } }
      },
      "additionalProperties": false
    },
    "currentReference": {
      "type": "object",
      "required": ["id", "pointsToRoot", "priorRoots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "pointsToRoot": { "$ref": "#/$defs/root" },
        "priorRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } }
      },
      "additionalProperties": false
    },
    "semanticInferences": {
      "type": "object",
      "required": ["pursuit", "warrant", "completeness", "currentValidity"],
      "properties": {
        "pursuit": { "type": "boolean" },
        "warrant": { "type": "boolean" },
        "completeness": { "type": "boolean" },
        "currentValidity": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["claimBoundary"],
      "properties": { "claimBoundary": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "properties": { "stale": { "const": true } }, "required": ["stale"] } } },
      "then": { "properties": { "freshness": { "properties": { "state": { "const": "stale" } } } } }
    },
    {
      "if": { "properties": { "state": { "properties": { "degraded": { "const": true } }, "required": ["degraded"] } } },
      "then": { "properties": { "loss": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "state": { "properties": { "conflicted": { "const": true } }, "required": ["conflicted"] } } },
      "then": { "properties": { "scope": { "properties": { "unknowns": { "minItems": 1 } } } } }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
