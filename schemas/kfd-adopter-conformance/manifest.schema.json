{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-adopter-conformance/manifest.schema.json",
  "title": "KFD Full-Cut Adopter Conformance Manifest",
  "description": "A package-only declaration over one exact KFD registry cut. Schema validity is structural and does not grant runtime permission, release authorization, or certification.",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "manifestId",
    "rootAlgorithm",
    "byteDigestAlgorithm",
    "adopter",
    "kfdCut",
    "decisions",
    "releaseBindings",
    "claimBoundary",
    "gaps"
  ],
  "properties": {
    "$schema": { "const": "https://kfd.libkungfu.dev/schemas/kfd-adopter-conformance/manifest.schema.json" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.adopter-conformance-manifest/v1" },
    "manifestId": { "$ref": "#/$defs/nonEmpty" },
    "rootAlgorithm": { "const": "sha256-kfd-canonical-json-v1" },
    "byteDigestAlgorithm": { "const": "sha256-bytes-v1" },
    "adopter": {
      "type": "object",
      "required": ["id", "artifact", "scope"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "artifact": { "$ref": "#/$defs/artifactCoordinate" },
        "scope": { "$ref": "#/$defs/nonEmpty" }
      },
      "additionalProperties": false
    },
    "kfdCut": {
      "type": "object",
      "required": [
        "package",
        "registry",
        "standards",
        "schemaSet",
        "schemaSetRoot",
        "vectorSet",
        "vectorSetRoot",
        "verifierSet",
        "verifierSetRoot",
        "decisionSetRoot"
      ],
      "properties": {
        "package": {
          "type": "object",
          "required": ["name", "version", "artifactRoot"],
          "properties": {
            "name": { "const": "@kungfu-tech/kfd" },
            "version": { "$ref": "#/$defs/nonEmpty" },
            "artifactRoot": { "$ref": "#/$defs/root" }
          },
          "additionalProperties": false
        },
        "registry": { "$ref": "#/$defs/rootedPackageJson" },
        "standards": { "$ref": "#/$defs/rootedPackageJson" },
        "schemaSet": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/schemaSurface" }
        },
        "schemaSetRoot": { "$ref": "#/$defs/root" },
        "vectorSet": {
          "type": "array",
          "items": { "$ref": "#/$defs/vectorSurface" }
        },
        "vectorSetRoot": { "$ref": "#/$defs/root" },
        "verifierSet": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verifierSurface" }
        },
        "verifierSetRoot": { "$ref": "#/$defs/root" },
        "decisionSetRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionDeclaration" }
    },
    "releaseBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/releaseBinding" }
    },
    "claimBoundary": {
      "type": "object",
      "required": [
        "declarationOnly",
        "runtimePermission",
        "releaseAuthorization",
        "independentlyCertified",
        "semanticTruth"
      ],
      "properties": {
        "declarationOnly": { "const": true },
        "runtimePermission": { "const": false },
        "releaseAuthorization": { "const": false },
        "independentlyCertified": { "const": false },
        "semanticTruth": { "const": false }
      },
      "additionalProperties": false
    },
    "gaps": { "$ref": "#/$defs/stringSet" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "packagePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "artifactCoordinate": {
      "type": "object",
      "required": ["kind", "coordinate", "root"],
      "properties": {
        "kind": { "enum": ["git-commit", "package", "container", "archive", "release", "other"] },
        "coordinate": { "$ref": "#/$defs/nonEmpty" },
        "root": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "rootedPackageJson": {
      "type": "object",
      "required": ["path", "schemaVersion", "contract", "root"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "contract": { "$ref": "#/$defs/nonEmpty" },
        "root": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "packageSurface": {
      "type": "object",
      "required": ["path", "byteRoot"],
      "properties": {
        "path": { "$ref": "#/$defs/packagePath" },
        "byteRoot": { "$ref": "#/$defs/root" }
      }
    },
    "schemaSurface": {
      "allOf": [
        { "$ref": "#/$defs/packageSurface" },
        {
          "type": "object",
          "required": ["schemaId"],
          "properties": { "schemaId": { "type": "string", "format": "uri" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "vectorSurface": {
      "allOf": [
        { "$ref": "#/$defs/packageSurface" },
        {
          "type": "object",
          "required": ["contract"],
          "properties": { "contract": { "$ref": "#/$defs/nonEmpty" } }
        }
      ],
      "unevaluatedProperties": false
    },
    "verifierSurface": {
      "allOf": [
        { "$ref": "#/$defs/packageSurface" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "enum": ["executable", "wasm", "source", "specification"] } }
        }
      ],
      "unevaluatedProperties": false
    },
    "evidenceReference": {
      "type": "object",
      "required": ["kind", "coordinate", "root", "observedAt", "kfdPackageRoot"],
      "properties": {
        "kind": { "enum": ["implementation", "verification", "negative", "review"] },
        "coordinate": { "$ref": "#/$defs/nonEmpty" },
        "root": { "$ref": "#/$defs/root" },
        "observedAt": { "type": "string", "format": "date-time" },
        "kfdPackageRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "witnessBinding": {
      "type": "object",
      "required": [
        "decisionId",
        "profileId",
        "profileManifestPath",
        "profileManifestRoot",
        "witnessCoordinate",
        "witnessRoot",
        "verifierRoot",
        "kfdPackageRoot"
      ],
      "properties": {
        "decisionId": { "type": "string", "pattern": "^KFD-[1-9][0-9]*$" },
        "profileId": { "$ref": "#/$defs/nonEmpty" },
        "profileManifestPath": { "$ref": "#/$defs/packagePath" },
        "profileManifestRoot": { "$ref": "#/$defs/root" },
        "witnessCoordinate": { "$ref": "#/$defs/nonEmpty" },
        "witnessRoot": { "$ref": "#/$defs/root" },
        "verifierRoot": { "$ref": "#/$defs/root" },
        "kfdPackageRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "decisionDeclaration": {
      "type": "object",
      "required": [
        "id",
        "number",
        "registryStatus",
        "state",
        "usage",
        "implementationEvidence",
        "verificationEvidence",
        "negativeEvidence",
        "reviews",
        "witnessBindings",
        "releaseBindingIds",
        "claims",
        "gaps"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^KFD-[1-9][0-9]*$" },
        "number": { "type": "integer", "minimum": 1 },
        "registryStatus": { "enum": ["active", "draft", "superseded"] },
        "state": { "enum": ["adopted", "candidate", "draft-evidence", "unsupported", "not-used"] },
        "usage": { "enum": ["used", "evaluating", "unused"] },
        "implementationEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "verificationEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "negativeEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceReference" }
        },
        "witnessBindings": {
          "type": "array",
          "items": { "$ref": "#/$defs/witnessBinding" }
        },
        "releaseBindingIds": { "$ref": "#/$defs/stringSet" },
        "claims": { "$ref": "#/$defs/stringSet" },
        "gaps": { "$ref": "#/$defs/stringSet" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "adopted" } }, "required": ["state"] },
          "then": {
            "properties": {
              "usage": { "const": "used" },
              "implementationEvidence": { "minItems": 1 },
              "verificationEvidence": { "minItems": 1 },
              "witnessBindings": { "minItems": 1 },
              "releaseBindingIds": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "candidate" } }, "required": ["state"] },
          "then": { "properties": { "usage": { "enum": ["used", "evaluating"] } } }
        },
        {
          "if": { "properties": { "state": { "const": "draft-evidence" } }, "required": ["state"] },
          "then": {
            "properties": {
              "registryStatus": { "const": "draft" },
              "usage": { "enum": ["used", "evaluating"] },
              "verificationEvidence": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "unsupported" } }, "required": ["state"] },
          "then": { "properties": { "gaps": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "state": { "const": "not-used" } }, "required": ["state"] },
          "then": {
            "properties": {
              "usage": { "const": "unused" },
              "implementationEvidence": { "maxItems": 0 },
              "verificationEvidence": { "maxItems": 0 },
              "witnessBindings": { "maxItems": 0 },
              "releaseBindingIds": { "maxItems": 0 },
              "claims": { "maxItems": 0 }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "releaseBinding": {
      "type": "object",
      "required": ["id", "artifact", "releasePassport", "kfdPackageRoot"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "artifact": { "$ref": "#/$defs/artifactCoordinate" },
        "releasePassport": { "$ref": "#/$defs/artifactCoordinate" },
        "kfdPackageRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
