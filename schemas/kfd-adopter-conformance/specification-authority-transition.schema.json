{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-adopter-conformance/specification-authority-transition.schema.json",
  "title": "KFD specification-authority transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contract", "transitionId", "mode", "authority", "candidate", "changedSurfaces", "bootstrapAnchor", "evidence", "claimBoundary"],
  "properties": {
    "$schema": { "const": "https://kfd.libkungfu.dev/schemas/kfd-adopter-conformance/specification-authority-transition.schema.json" },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.specification-authority-transition/v1" },
    "transitionId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["bootstrap", "prior-cut"] },
    "authority": { "$ref": "#/$defs/cut" },
    "candidate": { "$ref": "#/$defs/cut" },
    "changedSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "beforeRoot", "afterRoot"],
        "properties": {
          "id": { "enum": ["candidate-generation", "profile", "schema", "verifier"] },
          "beforeRoot": { "$ref": "#/$defs/root" },
          "afterRoot": { "$ref": "#/$defs/root" }
        }
      }
    },
    "bootstrapAnchor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["packageVersion", "packageRoot", "reviewRoot"],
          "properties": {
            "packageVersion": { "type": "string", "minLength": 1 },
            "packageRoot": { "$ref": "#/$defs/root" },
            "reviewRoot": { "$ref": "#/$defs/root" }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declarationRoot", "reviewRoot", "verificationRoot"],
      "properties": {
        "declarationRoot": { "$ref": "#/$defs/root" },
        "reviewRoot": { "$ref": "#/$defs/root" },
        "verificationRoot": { "$ref": "#/$defs/root" }
      }
    },
    "claimBoundary": {
      "const": {
        "semanticTruth": false,
        "selfCertification": false,
        "releaseAuthorization": false,
        "authorityTransfer": false
      }
    }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageVersion", "packageRoot", "verifierRoot"],
      "properties": {
        "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-alpha\\.[0-9]+$" },
        "packageRoot": { "$ref": "#/$defs/root" },
        "verifierRoot": { "$ref": "#/$defs/root" }
      }
    }
  }
}
