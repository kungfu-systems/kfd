{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-agent-hub/capabilities.schema.json",
  "title": "KFD Agent Hub capabilities",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "identity",
    "profileVersions",
    "operations",
    "topologies",
    "disclosureModes",
    "failureCodes",
    "bindings",
    "limits",
    "authorityRoots",
    "issuedAt"
  ],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-agent-hub/capabilities.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd-agent-hub-capabilities" },
    "identity": { "$ref": "#/$defs/endpointIdentity" },
    "profileVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^0\\.1\\.0-alpha\\.[1-9][0-9]*$"
      }
    },
    "requiredFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" },
      "default": []
    },
    "optionalFeatures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" },
      "default": []
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/operation" }
    },
    "topologies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "local-peer",
          "single-vendor-cloud",
          "multi-organization-federation",
          "offline-device"
        ]
      }
    },
    "disclosureModes": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/disclosureMode" }
    },
    "failureCodes": {
      "type": "array",
      "minItems": 17,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/failureCode" }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mediaTypes",
          "authentication",
          "transportReceipts",
          "duplicateDelivery"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "mediaTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "authentication": {
            "type": "string",
            "minLength": 1
          },
          "transportReceipts": { "const": true },
          "duplicateDelivery": {
            "enum": ["at-least-once", "at-most-once", "exactly-once-emulated"]
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "required": ["maxInlineBytes", "maxEnvelopeBytes"],
      "properties": {
        "maxInlineBytes": { "type": "integer", "minimum": 0 },
        "maxEnvelopeBytes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "authorityRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/root" }
    },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "root": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "endpointIdentity": {
      "type": "object",
      "required": ["hubId", "nodeId", "actorId"],
      "properties": {
        "hubId": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "organizationId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "operation": {
      "enum": [
        "capability-advertisement",
        "responsibility-proposal",
        "fact-admission",
        "supersession",
        "completion-assessment",
        "warrant-revocation"
      ]
    },
    "disclosureMode": {
      "enum": [
        "full",
        "partial",
        "redacted",
        "reference-only",
        "intentionally-withheld"
      ]
    },
    "failureCode": {
      "enum": [
        "profile-version-unsupported",
        "profile-root-mismatch",
        "required-feature-unsupported",
        "identity-unresolved",
        "authority-unresolved",
        "authority-expired",
        "authority-revoked",
        "authority-amplification",
        "fact-cut-unavailable",
        "causal-gap",
        "payload-digest-mismatch",
        "idempotency-conflict",
        "conflict-visible",
        "disclosure-insufficient",
        "required-field-withheld",
        "completion-unproved",
        "local-policy-rejected"
      ]
    }
  }
}
