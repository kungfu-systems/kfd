{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-agent-runtime/adapter-request.schema.json",
  "title": "KFD Agent runtime black-box adapter request",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "operation",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd.agent-runtime-adapter-request/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "handshake",
        "evaluate"
      ]
    },
    "input": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
