{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-agent-runtime/adapter-response.schema.json",
  "title": "KFD Agent runtime black-box adapter response",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "requestId",
    "adapter",
    "status",
    "code",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd.agent-runtime-adapter-response/v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "required": [
        "id",
        "version",
        "topology"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "error"
      ]
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
