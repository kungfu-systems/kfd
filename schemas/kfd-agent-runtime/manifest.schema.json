{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-agent-runtime/manifest.schema.json",
  "title": "KFD Agent runtime suite manifest",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "profile",
    "suite",
    "partitions",
    "dependencies",
    "adapter",
    "report",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-agent-runtime/manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd.agent-runtime-suite-manifest/v1"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status",
        "authority"
      ],
      "properties": {
        "id": {
          "const": "kfd-agent-runtime"
        },
        "version": {
          "const": "0.1.0-alpha.1"
        },
        "status": {
          "const": "experimental"
        },
        "authority": {
          "const": "profiles/agent-runtime/README.md"
        }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": [
        "id",
        "version",
        "fixedVectorCount",
        "vectorRoot"
      ],
      "properties": {
        "id": {
          "const": "kfd-runtime-100"
        },
        "version": {
          "const": "0.1.0-alpha.1"
        },
        "fixedVectorCount": {
          "const": 100
        },
        "vectorRoot": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "partitions": {
      "type": "object",
      "required": [
        "core",
        "experimental"
      ],
      "properties": {
        "core": {
          "$ref": "#/$defs/partition"
        },
        "experimental": {
          "$ref": "#/$defs/partition"
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "required": [
        "agentHubProfile",
        "agentHubManifestDigest"
      ],
      "properties": {
        "agentHubProfile": {
          "const": "kfd-agent-hub@0.1.0-alpha.1"
        },
        "agentHubManifestDigest": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": [
        "contract",
        "responseContract",
        "binding",
        "requestSchema",
        "responseSchema"
      ],
      "properties": {
        "contract": {
          "const": "kfd.agent-runtime-adapter-request/v1"
        },
        "responseContract": {
          "const": "kfd.agent-runtime-adapter-response/v1"
        },
        "binding": {
          "const": "jsonl-stdio/v1"
        },
        "requestSchema": {
          "const": "schemas/kfd-agent-runtime/adapter-request.schema.json"
        },
        "responseSchema": {
          "const": "schemas/kfd-agent-runtime/adapter-response.schema.json"
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": [
        "contract",
        "schema",
        "qualifying",
        "selfCertified",
        "offlineVerification"
      ],
      "properties": {
        "contract": {
          "const": "kfd.agent-runtime-report/v1"
        },
        "schema": {
          "const": "schemas/kfd-agent-runtime/report.schema.json"
        },
        "qualifying": {
          "const": false
        },
        "selfCertified": {
          "const": false
        },
        "offlineVerification": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "digest"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "authority",
              "schema",
              "vectors",
              "runner",
              "verifier",
              "reference"
            ]
          },
          "digest": {
            "$ref": "#/$defs/root"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "partition": {
      "type": "object",
      "required": [
        "authority",
        "vectorCount",
        "claim"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "vectorCount": {
          "type": "integer",
          "minimum": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
