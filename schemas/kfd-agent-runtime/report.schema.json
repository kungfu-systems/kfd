{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-agent-runtime/report.schema.json",
  "title": "KFD Agent runtime conformance execution report",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "profile",
    "suite",
    "adapter",
    "platform",
    "execution",
    "partitions",
    "valid",
    "qualifying",
    "selfCertified",
    "results",
    "residualRisk"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd.agent-runtime-report/v1"
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version",
        "manifestDigest",
        "agentHubManifestDigest"
      ],
      "properties": {
        "id": {
          "const": "kfd-agent-runtime"
        },
        "version": {
          "const": "0.1.0-alpha.1"
        },
        "manifestDigest": {
          "$ref": "#/$defs/root"
        },
        "agentHubManifestDigest": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": [
        "id",
        "version",
        "vectorCount",
        "vectorRoot"
      ],
      "properties": {
        "id": {
          "const": "kfd-runtime-100"
        },
        "version": {
          "const": "0.1.0-alpha.1"
        },
        "vectorCount": {
          "const": 100
        },
        "vectorRoot": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "adapter": {
      "type": "object",
      "required": [
        "id",
        "version",
        "topology",
        "artifactDigest",
        "handshake",
        "handshakeRoot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "type": "string",
          "minLength": 1
        },
        "artifactDigest": {
          "$ref": "#/$defs/root"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "handshake": {
          "type": "object"
        },
        "handshakeRoot": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "arch",
        "runtime"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "startedAt",
        "finishedAt",
        "offline",
        "requestCount",
        "transcriptRoot",
        "resultRoot"
      ],
      "properties": {
        "startedAt": {
          "type": "string",
          "minLength": 1
        },
        "finishedAt": {
          "type": "string",
          "minLength": 1
        },
        "offline": {
          "const": true
        },
        "requestCount": {
          "const": 101
        },
        "transcriptRoot": {
          "$ref": "#/$defs/root"
        },
        "resultRoot": {
          "$ref": "#/$defs/root"
        }
      },
      "additionalProperties": false
    },
    "partitions": {
      "type": "object",
      "required": [
        "core",
        "experimental"
      ],
      "properties": {
        "core": {
          "$ref": "#/$defs/partition"
        },
        "experimental": {
          "$ref": "#/$defs/partition"
        }
      },
      "additionalProperties": false
    },
    "valid": {
      "type": "boolean"
    },
    "qualifying": {
      "const": false
    },
    "selfCertified": {
      "const": false
    },
    "results": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "partition",
          "category",
          "status",
          "expected",
          "actual",
          "response",
          "responseRoot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "partition": {
            "enum": [
              "core",
              "experimental"
            ]
          },
          "category": {
            "enum": [
              "pursuit",
              "atlas",
              "warrant",
              "action",
              "episode-fact",
              "recovery"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "expected": {
            "$ref": "#/$defs/outcome"
          },
          "actual": {
            "$ref": "#/$defs/outcome"
          },
          "response": {
            "type": "object"
          },
          "responseRoot": {
            "$ref": "#/$defs/root"
          }
        },
        "additionalProperties": false
      }
    },
    "residualRisk": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "root": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "partition": {
      "type": "object",
      "required": [
        "total",
        "passed",
        "failed",
        "status"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": [
        "status",
        "code"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
