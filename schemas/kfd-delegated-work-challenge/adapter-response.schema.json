{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-delegated-work-challenge/adapter-response.schema.json",
  "title": "KFD Delegated Work challenge adapter response",
  "type": "object",
  "required": ["schemaVersion", "contract", "requestId", "adapter"],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "kfd.delegated-work-adapter-response/v1"},
    "requestId": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["accepted", "completed"]},
    "code": {"type": "string", "minLength": 1},
    "decision": {
      "type": "object",
      "required": ["mayAdvance", "disposition"],
      "properties": {
        "mayAdvance": {"type": "boolean"},
        "disposition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "authoritativeSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["object", "identity", "revision"],
        "properties": {
          "object": {"type": "string", "minLength": 1},
          "identity": {"type": "string", "minLength": 1},
          "revision": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "enforcementPoint": {"type": "string", "minLength": 1},
    "survivesExecutorReplacement": {"type": "boolean"},
    "replacementContinuityMechanism": {"type": "string", "minLength": 1},
    "humanReconstructionRequired": {"type": "boolean"}
  },
  "additionalProperties": false
}
