{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-delegated-work-challenge/report.schema.json",
  "title": "KFD Delegated Work paired-world challenge report",
  "type": "object",
  "required": [
    "schemaVersion", "contract", "sourceCut", "challenge", "suite", "projection",
    "platform", "execution", "findings", "summary", "claimBoundary", "residualRisks",
    "qualifying", "certification", "reportRoot"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "kfd.delegated-work-challenge-report/v1"},
    "sourceCut": {"type": "object"},
    "challenge": {"type": "object"},
    "suite": {"type": "object"},
    "projection": {"type": "object"},
    "adapter": {"type": "object"},
    "platform": {"type": "object"},
    "execution": {"type": "object"},
    "findings": {"type": "array", "minItems": 1},
    "summary": {"type": "object"},
    "claimBoundary": {"type": "object"},
    "residualRisks": {"type": "array", "minItems": 1},
    "qualifying": {"const": false},
    "certification": {"const": false},
    "reportRoot": {"$ref": "#/$defs/root"}
  },
  "additionalProperties": false,
  "$defs": {
    "root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
