{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-evidence/primitive-evidence-bundle.schema.json",
  "title": "KFD Primitive Evidence Bundle",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "bundleId",
    "primitive",
    "source",
    "pressureField",
    "mapping",
    "evidenceClass",
    "candidateInvariants",
    "reusableTestRoots",
    "failureOrCounterexample",
    "review",
    "lineage",
    "observation",
    "assessment",
    "qualifying",
    "selfCertified"
  ],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-evidence/primitive-evidence-bundle.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.primitive-evidence-bundle/v1" },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
    "primitive": { "const": "Warrant" },
    "source": { "$ref": "#/$defs/source" },
    "pressureField": { "type": "string", "minLength": 1 },
    "mapping": {
      "type": "object",
      "required": ["decision", "primitive", "kfdClauses"],
      "properties": {
        "decision": { "const": "KFD-10" },
        "primitive": { "const": "Warrant" },
        "kfdClauses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "evidenceClass": {
      "enum": ["generic-candidate", "profile-specific", "counterexample", "no-new-primitive", "unresolved"]
    },
    "candidateInvariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reusableTestRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "failureOrCounterexample": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "required": ["state", "reviewerClass", "evidenceRoots"],
      "properties": {
        "state": { "enum": ["self-reviewed", "independent-reviewed", "revision-required"] },
        "reviewerClass": { "enum": ["same-steward", "independent"] },
        "evidenceRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/root" } }
      },
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "required": ["sourceEntryId", "predecessorBundleIds"],
      "properties": {
        "sourceEntryId": { "type": "string", "minLength": 1 },
        "predecessorBundleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": ["upstreamContract", "kind", "summary"],
      "properties": {
        "upstreamContract": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["implementation-contract", "implementation-fixture", "retained-report"] },
        "summary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["verdict", "genericClaims", "profileSpecificClaims", "promotion"],
      "properties": {
        "verdict": { "enum": ["proved", "partial", "missing", "invalidated"] },
        "genericClaims": { "$ref": "#/$defs/claims" },
        "profileSpecificClaims": { "$ref": "#/$defs/claims" },
        "promotion": {
          "type": "object",
          "required": ["allowed", "reason"],
          "properties": {
            "allowed": { "const": false },
            "reason": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "qualifying": { "const": false },
    "selfCertified": { "const": false }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "gitSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "tree", "path", "contentRoot", "public", "retained"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
        "commit": { "$ref": "#/$defs/gitSha" },
        "tree": { "$ref": "#/$defs/gitSha" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "contentRoot": { "$ref": "#/$defs/root" },
        "public": { "const": true },
        "retained": { "const": true }
      },
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "basis"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "status": { "enum": ["proved", "partial", "missing", "invalidated"] },
          "basis": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
