{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-live-case-registry.schema.json",
  "title": "KFD live case registry",
  "type": "object",
  "required": ["schemaVersion", "contract", "cases"],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-live-case-registry.schema.json"
    },
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd-live-case-registry" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/liveCase" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "liveCase": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "status",
        "standard",
        "humanEntry",
        "genesis",
        "methodTrace",
        "propagationHypothesis",
        "reviewIndex",
        "currentCut",
        "claimBoundary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "const": "primitive-candidate" },
        "status": {
          "enum": ["provisional", "accepted", "rejected", "subsumed", "no-new-primitive"]
        },
        "standard": { "const": "kfd-5" },
        "humanEntry": {
          "type": "string",
          "pattern": "^cases/live/[a-z0-9-]+/README\\.md$"
        },
        "genesis": {
          "type": "string",
          "pattern": "^cases/live/[a-z0-9-]+/genesis\\.md$"
        },
        "methodTrace": {
          "type": "string",
          "pattern": "^cases/live/[a-z0-9-]+/kfd-method-trace\\.md$"
        },
        "propagationHypothesis": {
          "type": "string",
          "pattern": "^cases/live/[a-z0-9-]+/propagation-hypothesis\\.md$"
        },
        "reviewIndex": {
          "type": "string",
          "pattern": "^cases/live/[a-z0-9-]+/reviews/README\\.md$"
        },
        "currentCut": {
          "type": "object",
          "required": ["path", "sha256", "schemaId", "schemaVersion"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^cases/live/[a-z0-9-]+/cuts/[0-9]{4}-[a-z0-9-]+\\.json$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schemaId": {
              "const": "https://kfd.libkungfu.dev/schemas/kfd-5/primitive-discovery.schema.json"
            },
            "schemaVersion": { "const": 3 }
          },
          "additionalProperties": false
        },
        "claimBoundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
