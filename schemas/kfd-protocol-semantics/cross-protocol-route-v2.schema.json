{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-protocol-semantics/cross-protocol-route-v2.schema.json",
  "title": "KFD Ordered Cross-Protocol Route",
  "type": "object",
  "required": ["schemaVersion", "contract", "id", "requiredSemantics", "expectedHopIds", "hops", "result", "claimBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.cross-protocol-route/v2" },
    "id": { "$ref": "#/$defs/id" },
    "requiredSemantics": { "$ref": "#/$defs/ids" },
    "expectedHopIds": { "$ref": "#/$defs/ids" },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "input", "output", "mappings", "losses", "inference", "authorityTransition"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "input": { "$ref": "#/$defs/endpoint" },
          "output": { "$ref": "#/$defs/endpoint" },
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["semanticId", "state", "evidenceRoots"],
              "properties": {
                "semanticId": { "$ref": "#/$defs/id" },
                "state": { "$ref": "#/$defs/state" },
                "evidenceRoots": { "$ref": "#/$defs/nonemptyRoots" }
              },
              "additionalProperties": false
            }
          },
          "losses": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["semanticId", "kind", "summary", "evidenceRoots"],
              "properties": {
                "semanticId": { "$ref": "#/$defs/id" },
                "kind": { "$ref": "#/$defs/id" },
                "summary": { "type": "string", "minLength": 1 },
                "evidenceRoots": { "$ref": "#/$defs/nonemptyRoots" }
              },
              "additionalProperties": false
            }
          },
          "inference": {
            "type": "object",
            "required": ["mode", "evidenceRoots"],
            "properties": {
              "mode": { "enum": ["none", "declared"] },
              "evidenceRoots": { "$ref": "#/$defs/roots" }
            },
            "additionalProperties": false
          },
          "authorityTransition": {
            "type": "object",
            "required": ["fromRevision", "toRevision", "changed", "evidenceRoots"],
            "properties": {
              "fromRevision": { "$ref": "#/$defs/root" },
              "toRevision": { "$ref": "#/$defs/root" },
              "changed": { "type": "boolean" },
              "evidenceRoots": { "$ref": "#/$defs/nonemptyRoots" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "result": {
      "type": "object",
      "required": ["state", "pairedWorldCollapse", "evidenceRoots"],
      "properties": {
        "state": { "$ref": "#/$defs/state" },
        "pairedWorldCollapse": { "type": "boolean" },
        "evidenceRoots": { "$ref": "#/$defs/nonemptyRoots" }
      },
      "additionalProperties": false
    },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "nonemptyRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "state": { "enum": ["preserved", "extension-required", "out-of-scope", "collapsed"] },
    "endpoint": {
      "type": "object",
      "required": ["protocolId", "protocolVersion", "evidencePackRoot", "canonicalWorkRoot", "canonicalWorkSource", "nativeIdentity", "authorityRevision"],
      "properties": {
        "protocolId": { "$ref": "#/$defs/id" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "evidencePackRoot": { "$ref": "#/$defs/root" },
        "canonicalWorkRoot": { "$ref": "#/$defs/root" },
        "canonicalWorkSource": { "const": "work" },
        "nativeIdentity": {
          "type": "object",
          "required": ["kind", "identityRoot"],
          "properties": {
            "kind": { "enum": ["invocation", "message", "payment", "runtime", "session", "task"] },
            "identityRoot": { "$ref": "#/$defs/root" }
          },
          "additionalProperties": false
        },
        "authorityRevision": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["informationPreservationOnly", "certification", "runtimeAuthority", "interoperabilityGuarantee"],
      "properties": {
        "informationPreservationOnly": { "const": true },
        "certification": { "const": false },
        "runtimeAuthority": { "const": false },
        "interoperabilityGuarantee": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
