{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-protocol-semantics/protocol-observation.schema.json",
  "title": "KFD Normalized Protocol Observation",
  "type": "object",
  "required": ["schemaVersion", "contract", "id", "protocol", "adapter", "facts", "claimBoundary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.protocol-observation/v1" },
    "id": { "$ref": "#/$defs/id" },
    "protocol": { "$ref": "#/$defs/protocolReference" },
    "adapter": {
      "type": "object",
      "required": ["id", "version", "artifactRoot"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "artifactRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "state", "evidenceRoots", "value"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "state": { "const": "represented" },
              "evidenceRoots": { "$ref": "#/$defs/nonemptyRoots" },
              "value": {}
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "state", "evidenceRoots"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "state": { "enum": ["extension-required", "out-of-scope", "unresolved"] },
              "evidenceRoots": { "$ref": "#/$defs/roots" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "claimBoundary": {
      "type": "object",
      "required": ["normalizedObservationOnly", "certification", "runtimeAuthority", "policyCorrectness"],
      "properties": {
        "normalizedObservationOnly": { "const": true },
        "certification": { "const": false },
        "runtimeAuthority": { "const": false },
        "policyCorrectness": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "roots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "nonemptyRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "protocolReference": {
      "type": "object",
      "required": ["protocolId", "protocolVersion", "evidencePackRoot"],
      "properties": {
        "protocolId": { "$ref": "#/$defs/id" },
        "protocolVersion": { "$ref": "#/$defs/version" },
        "evidencePackRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
