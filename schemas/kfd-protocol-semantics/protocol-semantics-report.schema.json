{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-protocol-semantics/protocol-semantics-report.schema.json",
  "title": "KFD Protocol Semantics Report",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "mode",
    "sourceCut",
    "suite",
    "registry",
    "route",
    "result",
    "claimBoundary",
    "residualRisks",
    "reportRoot"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "contract": {"const": "kfd.protocol-semantics-report/v1"},
    "mode": {"enum": ["protocol", "route"]},
    "sourceCut": {
      "type": "object",
      "required": ["repository", "package", "packageVersion", "gitHead", "packageManifestRoot", "releaseAnchorRoot", "profileManifestRoot"],
      "properties": {
        "repository": {"const": "kungfu-systems/kfd"},
        "package": {"const": "@kungfu-tech/kfd"},
        "packageVersion": {"type": "string", "minLength": 1},
        "gitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "packageManifestRoot": {"$ref": "#/$defs/root"},
        "releaseAnchorRoot": {"$ref": "#/$defs/root"},
        "profileManifestRoot": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "suite": {"$ref": "#/$defs/rootedObject"},
    "registry": {"$ref": "#/$defs/rootOnly"},
    "pack": {"type": "object"},
    "mapping": {"$ref": "#/$defs/rootOnly"},
    "route": {"type": "object"},
    "fixture": {"type": "object"},
    "adapter": {"type": "object"},
    "transcript": {"$ref": "#/$defs/rootOnly"},
    "result": {
      "type": "object",
      "required": ["state", "resultRoot"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "observationRoot": {"$ref": "#/$defs/root"},
        "resultRoot": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "observation": {"type": "object"},
    "claimBoundary": {
      "type": "object",
      "required": ["claim", "informationRepresentationExperiment", "runtimeAuthority", "numberedKfdAuthority", "externalRealityObserved", "root"],
      "properties": {
        "claim": {"const": "evidence-closure-only"},
        "informationRepresentationExperiment": {"const": true},
        "runtimeAuthority": {"const": false},
        "numberedKfdAuthority": {"const": false},
        "externalRealityObserved": {"const": false},
        "root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "residualRisks": {
      "type": "object",
      "required": ["risks", "root"],
      "properties": {
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["summary", "root"],
            "properties": {
              "summary": {"type": "string", "minLength": 1},
              "root": {"$ref": "#/$defs/root"}
            },
            "additionalProperties": false
          }
        },
        "root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    },
    "reportRoot": {"$ref": "#/$defs/root"}
  },
  "$defs": {
    "root": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rootOnly": {
      "type": "object",
      "required": ["root"],
      "properties": {"root": {"$ref": "#/$defs/root"}},
      "additionalProperties": false
    },
    "rootedObject": {
      "type": "object",
      "required": ["id", "version", "root"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "root": {"$ref": "#/$defs/root"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "protocol"}}, "required": ["mode"]},
      "then": {"required": ["pack", "mapping", "fixture", "adapter", "transcript", "observation"]}
    }
  ],
  "additionalProperties": false
}
