{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-self-conformance/lifecycle-gate-report.schema.json",
  "title": "KFD Self-Conformance lifecycle gate report",
  "type": "object",
  "required": ["schemaVersion", "contract", "profile", "gateId", "lifecyclePath", "requestRoot", "fixedPackageRoot", "terminalBundleRoot", "terminalReportRoot", "valid", "outcome", "transitionAdmissible", "automaticTransition", "verifierNecessary", "verifierSufficient", "humanApproved", "releaseAuthorized", "numberAllocated", "statusChanged", "chain", "counterevidenceRoots", "checks", "issues", "offline"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.self-conformance-lifecycle-gate-report/v1" },
    "profile": { "const": "kfd-self-conformance@1.0.0-alpha.1" },
    "gateId": { "type": "string", "minLength": 1 },
    "lifecyclePath": { "type": "string", "minLength": 1 },
    "requestRoot": { "$ref": "#/$defs/root" },
    "fixedPackageRoot": { "$ref": "#/$defs/root" },
    "terminalBundleRoot": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] },
    "terminalReportRoot": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] },
    "valid": { "type": "boolean" },
    "outcome": { "enum": ["proceed", "non-promotion", "blocked"] },
    "transitionAdmissible": { "type": "boolean" },
    "automaticTransition": { "const": false },
    "verifierNecessary": { "const": true },
    "verifierSufficient": { "const": false },
    "humanApproved": { "const": false },
    "releaseAuthorized": { "const": false },
    "numberAllocated": { "const": false },
    "statusChanged": { "const": false },
    "chain": { "type": "array" },
    "counterevidenceRoots": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/root" } },
    "checks": { "type": "array" },
    "issues": { "type": "array" },
    "offline": { "const": true }
  },
  "$defs": { "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
  "additionalProperties": false
}
