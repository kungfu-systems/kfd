{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-self-conformance/package-manifest.schema.json",
  "title": "KFD Self-Conformance package manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "profile",
    "authority",
    "rootAlgorithm",
    "schemaSetRoot",
    "vectorSetRoot",
    "issueSetRoot",
    "bootstrapAnchorRoot",
    "verifierRequirement",
    "runtimeDependencies",
    "forbiddenDependencies",
    "surfaces",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.self-conformance-package-manifest/v1" },
    "profile": {
      "type": "object",
      "required": ["id", "version", "status"],
      "properties": {
        "id": { "const": "kfd-self-conformance" },
        "version": { "const": "1.0.0-alpha.1" },
        "status": { "const": "experimental" }
      },
      "additionalProperties": false
    },
    "authority": { "const": "profiles/self-conformance/README.md" },
    "rootAlgorithm": { "const": "sha256-kfd-canonical-json-v1" },
    "schemaSetRoot": { "$ref": "#/$defs/root" },
    "vectorSetRoot": { "$ref": "#/$defs/root" },
    "issueSetRoot": { "$ref": "#/$defs/root" },
    "bootstrapAnchorRoot": { "$ref": "#/$defs/root" },
    "verifierRequirement": {
      "type": "object",
      "required": ["native", "wasm", "byteParity", "offline", "independent"],
      "properties": {
        "native": { "const": true },
        "wasm": { "const": true },
        "byteParity": { "const": true },
        "offline": { "const": true },
        "independent": { "const": true }
      },
      "additionalProperties": false
    },
    "runtimeDependencies": { "type": "array", "maxItems": 0 },
    "forbiddenDependencies": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["path", "role", "digest"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\./).+$" },
          "role": { "enum": ["authority", "guide", "schema", "reference", "vectors", "extraction", "check"] },
          "digest": { "$ref": "#/$defs/root" }
        },
        "additionalProperties": false
      }
    },
    "claimBoundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
