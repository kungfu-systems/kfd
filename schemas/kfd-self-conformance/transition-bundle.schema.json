{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-self-conformance/transition-bundle.schema.json",
  "title": "KFD Self-Conformance transition bundle",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "profile",
    "bundleId",
    "transition",
    "previousState",
    "previousStateRoot",
    "proposedState",
    "proposedStateRoot",
    "predecessor",
    "evidenceRoots",
    "schemaSetRoot",
    "verifierRoot",
    "authorityReceiptRoot",
    "reviewReceiptRoot",
    "claimBoundary",
    "knownGaps",
    "expectedResult",
    "immutableCoordinates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contract": { "const": "kfd.self-conformance-transition-bundle/v1" },
    "profile": { "const": "kfd-self-conformance@1.0.0-alpha.1" },
    "bundleId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "transition": {
      "enum": [
        "candidate-genesis",
        "candidate-qualification",
        "numbered-draft-promotion",
        "activation",
        "supersession",
        "foundation-revision",
        "release-packaging",
        "revision-required",
        "rejection",
        "provisional-retention",
        "no-new-kfd"
      ]
    },
    "previousState": { "$ref": "state.schema.json" },
    "previousStateRoot": { "$ref": "#/$defs/root" },
    "proposedState": { "$ref": "state.schema.json" },
    "proposedStateRoot": { "$ref": "#/$defs/root" },
    "predecessor": {
      "type": "object",
      "required": ["kind", "bootstrapAnchorRoot", "reportRoot", "packageRoot"],
      "properties": {
        "kind": { "enum": ["bootstrap", "report"] },
        "bootstrapAnchorRoot": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] },
        "reportRoot": { "oneOf": [{ "$ref": "#/$defs/root" }, { "type": "null" }] },
        "packageRoot": { "$ref": "#/$defs/root" }
      },
      "additionalProperties": false
    },
    "evidenceRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/root" }
    },
    "schemaSetRoot": { "$ref": "#/$defs/root" },
    "verifierRoot": { "$ref": "#/$defs/root" },
    "authorityReceiptRoot": { "$ref": "#/$defs/root" },
    "reviewReceiptRoot": { "$ref": "#/$defs/root" },
    "claimBoundary": { "type": "string", "minLength": 1 },
    "knownGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedResult": { "enum": ["pass", "fail"] },
    "immutableCoordinates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["kind", "value", "root"],
        "properties": {
          "kind": { "enum": ["git", "package", "artifact", "document"] },
          "value": { "type": "string", "minLength": 1 },
          "root": { "$ref": "#/$defs/root" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
