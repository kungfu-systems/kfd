{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-standards.schema.json",
  "title": "KFD standards metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "contract",
    "metadataSchema",
    "source",
    "standards"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "contract": {
      "const": "kfd-standards-metadata"
    },
    "metadataSchema": {
      "type": "object",
      "required": [
        "id",
        "path",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uri"
        },
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "package",
        "registry",
        "decisionsDir"
      ],
      "properties": {
        "package": {
          "const": "@kungfu-tech/kfd"
        },
        "registry": {
          "const": "registry.json"
        },
        "decisionsDir": {
          "const": "decisions"
        }
      },
      "additionalProperties": false
    },
    "standards": {
      "type": "object",
      "patternProperties": {
        "^kfd-[1-9][0-9]*$": {
          "$ref": "#/$defs/standard"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "standard": {
      "type": "object",
      "required": [
        "key",
        "id",
        "number",
        "label",
        "title",
        "kind",
        "status",
        "revision",
        "metadataSchemaVersion",
        "document",
        "formalModel",
        "compatibility",
        "schemaIds",
        "schemaPaths",
        "concepts"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^kfd-[1-9][0-9]*$"
        },
        "id": {
          "type": "string",
          "pattern": "^KFD-[1-9][0-9]*$"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "pattern": "^KFD-[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "principle",
            "procedure"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "superseded"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "metadataSchemaVersion": {
          "type": "string"
        },
        "document": {
          "type": "object",
          "required": [
            "path",
            "url"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "formalModel": {
          "$ref": "#/$defs/formalReference"
        },
        "compatibility": {
          "type": "object",
          "required": [
            "packageLine",
            "registrySchemaVersion",
            "metadataSchemaVersion",
            "rule"
          ],
          "properties": {
            "packageLine": {
              "type": "string"
            },
            "registrySchemaVersion": {
              "type": "integer",
              "minimum": 1
            },
            "metadataSchemaVersion": {
              "type": "string"
            },
            "rule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "schemaIds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        "schemaPaths": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "interfaces": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "contract",
              "schemaVersion",
              "schemaId",
              "schemaPath"
            ],
            "properties": {
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "schemaVersion": {
                "type": "integer",
                "minimum": 1
              },
              "schemaId": {
                "type": "string",
                "format": "uri"
              },
              "schemaPath": {
                "type": "string",
                "minLength": 1
              },
              "compatibilityRule": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "concepts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        },
        "surfaceRegister": {
          "$ref": "#/$defs/surfaceRegister"
        }
      },
      "additionalProperties": false
    },
    "formalReference": {
      "type": "object",
      "required": [
        "path",
        "url",
        "version",
        "status",
        "normative",
        "authorityPath",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/KFD-[1-9][0-9]*-formal\\.md$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "experimental",
            "stable",
            "deprecated"
          ]
        },
        "normative": {
          "const": false
        },
        "authorityPath": {
          "type": "string",
          "pattern": "^decisions/KFD-[1-9][0-9]*\\.md$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "surfaceClass": {
      "enum": [
        "integration-time",
        "cross-time"
      ]
    },
    "compatibilityImpact": {
      "enum": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ]
    },
    "impactProjection": {
      "type": "object",
      "required": [
        "breaking",
        "additive",
        "none",
        "unclassifiable"
      ],
      "properties": {
        "breaking": {
          "type": "string",
          "minLength": 1
        },
        "additive": {
          "type": "string",
          "minLength": 1
        },
        "none": {
          "type": "string",
          "minLength": 1
        },
        "unclassifiable": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "registeredSurface": {
      "type": "object",
      "required": [
        "id",
        "class",
        "description",
        "sourcePath",
        "impactProjection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "class": {
          "$ref": "#/$defs/surfaceClass"
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceClass"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "weldRationale": {
          "type": "string",
          "minLength": 1
        },
        "impactProjection": {
          "$ref": "#/$defs/impactProjection"
        }
      },
      "additionalProperties": false
    },
    "surfaceRegister": {
      "type": "object",
      "required": [
        "factSource",
        "surfaceClasses",
        "compatibilityImpactClasses",
        "surfaces"
      ],
      "properties": {
        "factSource": {
          "type": "string",
          "minLength": 1
        },
        "surfaceClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surfaceClass"
          },
          "uniqueItems": true
        },
        "compatibilityImpactClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/compatibilityImpact"
          },
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredSurface"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
