{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfd.libkungfu.dev/schemas/kfd-terminology.schema.json",
  "title": "KFD Terminology Contract",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "contract",
    "authority",
    "terms"
  ],
  "properties": {
    "$schema": {
      "const": "https://kfd.libkungfu.dev/schemas/kfd-terminology.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "contract": {
      "const": "kfd-terminology"
    },
    "authority": {
      "const": "docs/terminology.md"
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/term"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "term": {
      "type": "object",
      "required": [
        "id",
        "canonical",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    }
  }
}
