{
  "schemaVersion": 1,
  "contract": "kfd.self-conformance-verifier-matrix/v1",
  "profile": "kfd-self-conformance@1.0.0-alpha.1",
  "claimBoundary": "This matrix tests only fixed structural and cryptographic invariants. Historical cases preserve protocol regressions without importing adopter-specific semantics, and a pass does not qualify, certify, approve, promote, or authorize a release.",
  "invariants": [
    {
      "id": "canonical-json-domain",
      "positiveCases": ["matrix-positive-bootstrap", "matrix-positive-report-predecessor"],
      "failureCases": ["history-duplicate-json-key", "matrix-malformed-root"],
      "issueCodes": ["scp-contract-invalid"]
    },
    {
      "id": "closed-bundle-contract",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-unknown-field", "matrix-contract-substitution"],
      "issueCodes": ["scp-contract-invalid"]
    },
    {
      "id": "exact-profile-version",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-profile-version"],
      "issueCodes": ["scp-profile-version-unsupported"]
    },
    {
      "id": "evidence-root-closure",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-evidence-missing", "matrix-malformed-root"],
      "issueCodes": ["scp-evidence-roots-missing", "scp-contract-invalid"]
    },
    {
      "id": "state-root-binding",
      "positiveCases": ["matrix-positive-bootstrap", "matrix-positive-report-predecessor"],
      "failureCases": ["history-stale-predecessor-root", "matrix-stale-proposed-root"],
      "issueCodes": ["scp-predecessor-root-mismatch", "scp-proposed-root-mismatch"]
    },
    {
      "id": "schema-and-verifier-binding",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-schema-substitution", "matrix-verifier-missing"],
      "issueCodes": ["scp-schema-set-root-mismatch", "scp-verifier-root-missing"]
    },
    {
      "id": "set-order-and-uniqueness",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-reordered-evidence", "matrix-duplicate-evidence", "matrix-reordered-known-gaps"],
      "issueCodes": ["scp-set-order-invalid"]
    },
    {
      "id": "authority-review-separation",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-wrong-authority", "matrix-review-gap", "history-authority-review-collapse"],
      "issueCodes": ["scp-authority-receipt-missing", "scp-review-receipt-missing", "scp-root-substitution"]
    },
    {
      "id": "explicit-bounded-claims",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-claim-missing", "matrix-claim-overreach"],
      "issueCodes": ["scp-claim-boundary-missing", "scp-claim-overreach"]
    },
    {
      "id": "finite-predecessor-chain",
      "positiveCases": ["matrix-positive-bootstrap", "matrix-positive-report-predecessor"],
      "failureCases": ["matrix-wrong-bootstrap", "matrix-wrong-predecessor", "matrix-conflicting-predecessor", "matrix-circular-predecessor"],
      "issueCodes": ["scp-bootstrap-anchor-invalid", "scp-predecessor-root-mismatch", "scp-root-conflict"]
    },
    {
      "id": "non-self-containing-preimage",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["history-current-report-self-reference", "matrix-current-package-self-reference"],
      "issueCodes": ["scp-self-containing-report", "scp-self-containing-package"]
    },
    {
      "id": "transition-state-table",
      "positiveCases": ["matrix-positive-bootstrap", "matrix-positive-report-predecessor"],
      "failureCases": ["matrix-unknown-transition", "matrix-root-consistent-state-jump", "matrix-substituted-subject"],
      "issueCodes": ["scp-transition-unsupported", "scp-transition-state-invalid"]
    },
    {
      "id": "expected-result-agreement",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-expected-fail"],
      "issueCodes": ["scp-expected-result-mismatch"]
    },
    {
      "id": "explicit-gaps-and-coordinates",
      "positiveCases": ["matrix-positive-bootstrap"],
      "failureCases": ["matrix-known-gaps-missing", "matrix-coordinate-missing"],
      "issueCodes": ["scp-known-gaps-missing", "scp-immutable-coordinate-missing"]
    }
  ],
  "cases": [
    {
      "id": "matrix-positive-bootstrap",
      "invariant": "all",
      "category": "positive-bootstrap",
      "fixture": "contract-base",
      "history": false,
      "operations": [],
      "expected": { "valid": true, "code": null }
    },
    {
      "id": "matrix-positive-report-predecessor",
      "invariant": "finite-predecessor-chain",
      "category": "positive-cross-version",
      "fixture": "valid-report-predecessor",
      "history": false,
      "operations": [],
      "expected": { "valid": true, "code": null }
    },
    {
      "id": "history-duplicate-json-key",
      "invariant": "canonical-json-domain",
      "category": "malformed",
      "fixture": "raw",
      "history": true,
      "raw": "{\"schemaVersion\":1,\"schemaVersion\":1}",
      "operations": [],
      "expected": { "valid": false, "code": "scp-contract-invalid" }
    },
    {
      "id": "matrix-unknown-field",
      "invariant": "closed-bundle-contract",
      "category": "malformed",
      "fixture": "contract-base",
      "history": false,
      "operations": [{ "op": "add", "path": "/undeclared", "value": true }],
      "expected": { "valid": false, "code": "scp-contract-invalid" }
    },
    {
