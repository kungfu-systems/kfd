      "invariant": "closed-bundle-contract",
      "category": "substituted",
      "fixture": "contract-base",
      "history": false,
      "operations": [{ "op": "replace", "path": "/contract", "value": "kfd.self-conformance-transition-bundle/v2" }],
      "expected": { "valid": false, "code": "scp-contract-invalid" }
